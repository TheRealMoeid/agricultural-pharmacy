# Copy this file to .env and adjust. The real .env is never committed.
#
# For local development every value below has a working default (see
# config/settings/dev.py), so a .env is optional until you need to change one.

# Keep this secret in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# PostgreSQL connection, as a URL.
DATABASE_URL=postgres://pharmacy:pharmacy@localhost:5432/pharmacy

# Where the admin lives, with a trailing slash. Use something hard to guess
# in production.
DJANGO_ADMIN_URL=admin/

# Production and staging only:
# DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
# DJANGO_HSTS_SECONDS=3600
