# Copy this file to .env and adjust. The real .env is never committed.
#
# For local development every value below has a working default (see
# config/settings/dev.py), so a .env is optional until you need to change one.

# Keep this secret in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# PostgreSQL connection, as a URL. This value matches the database in compose.yml.
DATABASE_URL=postgres://pharmacy:pharmacy@localhost:5432/pharmacy

# Where the admin lives, with a trailing slash. Use something hard to guess
# in production.
DJANGO_ADMIN_URL=admin/

# Production and staging only:
# DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
# DJANGO_HSTS_SECONDS=3600
# META key of the header Nginx sets to the visitor's address (X-Real-IP):
# DJANGO_CLIENT_IP_HEADER=HTTP_X_REAL_IP

# The store's own Telegram bot (D42), which tells staff about a new
# consultation request. Get a token from @BotFather, and the chat id from the
# chat the bot should post to. With either one empty or missing, nothing is
# sent and the request says so -- normal for local development.
# DJANGO_TELEGRAM_BOT_TOKEN=123456789:AA...
# DJANGO_TELEGRAM_CHAT_ID=-1001234567890

# Render staging only (D44; render.yaml sets both of these for you):
# Render's proxy sets X-Forwarded-For, not X-Real-IP.
# DJANGO_CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR
# Render's free web service has no Nginx in front of it, so Django has to
# serve /media/ itself. Leave unset (or "false") anywhere Nginx does this.
# DJANGO_SERVE_MEDIA_VIA_DJANGO=true
